# AUG settings. Every variable is described in docs/configuration.md.
# ./augctl setup writes this file for you; copy it by hand only for a manual setup.

# REST API key: any long random string (openssl rand -hex 32)
API_KEY=change-me
# Encrypts stored OAuth tokens: openssl rand -base64 32. Keep it: losing it means
# connecting every account again.
OAUTH_ENCRYPTION_KEY=

# Telegram: the bot from @BotFather, and the user ids allowed to use it (@userinfobot).
# Empty TELEGRAM_ALLOWED_CHAT_IDS lets anyone use the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# An OpenAI-compatible endpoint: voice notes, image generation, the Kimi and GLM agents,
# the Home Assistant reflex. Claude Code and Codex do not use it. A LiteLLM proxy can serve
# several providers here.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Where links AUG sends you point: https://…, or http://localhost / http://127.0.0.1.
BASE_URL=http://localhost:8012

# Set for you by docker-compose.standalone.yml; needed here only for other setups.
# DATABASE_URL=postgresql+asyncpg://aug:password@localhost:5432/aug

# Optional integrations
# BRAVE_API_KEY=                 web search for the Kimi and GLM agents
# HASS_URL= / HASS_TOKEN=        Home Assistant (v15_* reflex)
# GMAIL_CLIENT_ID= / GMAIL_CLIENT_SECRET=
# PORTAINER_URL= / PORTAINER_API_TOKEN=
# AUG_CONTAINER=aug-aug-1        lets an MCP install restart AUG (with Portainer)
# AUG_ENVIRONMENT=local

# Production stack (docker-compose.prod.yml)
# MINIAPP_API_URL=https://api.example.com
# CHROME_USER=aug
# CHROME_PASSWORD=

# DEBUG=false                    true: plain, verbose logs
# DEV_AUTH_BYPASS=false          never true outside development
